{
  "name": "evalos-portals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"console.error('Two apps, two origins. Use: npm run dev:client (5174) or npm run dev:expert (5175).'); process.exit(1)\"",
    "dev:client": "cd client && vite",
    "dev:expert": "cd expert && vite",
    "build": "npm run build:client && npm run build:expert",
    "build:client": "cd client && tsc -b && vite build",
    "build:expert": "cd expert && tsc -b && vite build",
    "preview:client": "cd client && vite preview",
    "preview:expert": "cd expert && vite preview",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.102.5",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.14",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
